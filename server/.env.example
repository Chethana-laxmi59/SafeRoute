# SafeRoute Server Environment Configuration Template
# Duplicate this file to server/.env and fill in production secrets.
# NEVER commit server/.env to version control!

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Local MongoDB)
# Standard Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saferoute?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/saferoute?retryWrites=true&w=majority
# Fallback local connection string:
# MONGO_URI=mongodb://127.0.0.1:27017/saferoute

# JWT Authentication (Use a cryptographically secure 64-byte random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRE=30d

# Permitted Client Origins for CORS (Comma-separated for multiple domains)
# Example: https://saferoute.vercel.app,https://saferoute-preview.vercel.app
CLIENT_URL=https://saferoute.vercel.app


